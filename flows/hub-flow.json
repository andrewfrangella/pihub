 {
  "id": "tv_gen",
  "type": "function",
  "z": "dummytab",
  "name": "tv.m generator",
  "x": 300,
  "y": 100,
  "wires": [
   [
    "tv_enc"
   ]
  ],
  "func": "const frozen = flow.get('tv_m_frozen');\nlet v;\nif (typeof frozen === 'number') { v = frozen; }\nelse { const t = Date.now() / 1000; v = 0.5 + 0.4 * Math.sin(t * 0.3) + (Math.random() - 0.5) * 0.02; }\nv = Math.max(0, Math.min(1, v));\nnode.status({ fill: typeof frozen === 'number' ? 'yellow' : 'green', shape: 'dot', text: 'm=' + v.toFixed(3) });\nreturn { topic: '/tv/m', payload: { type: 'f', value: v }, ip: '127.0.0.1', port: 9000 };",
  "outputs": 1,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": []
 },
