 {
  "id": "tv_gen",
  "type": "function",
  "z": "dummytab",
  "name": "tv.m generator",
  "func": "// slow sine 0.1..0.9 plus a little noise, unless frozen by an inject button\nconst frozen = flow.get('tv_m_frozen');\nlet v;\nif (typeof frozen === 'number') {\n  v = frozen;\n} else {\n  const t = Date.now() / 1000;\n  v = 0.5 + 0.4 * Math.sin(t * 0.3) + (Math.random() - 0.5) * 0.02;\n}\nv = Math.max(0, Math.min(1, v));\nnode.status({ fill: typeof frozen === 'number' ? 'yellow' : 'green', shape: 'dot', text: 'm=' + v.toFixed(3) });\nreturn { topic: '/tv/m', payload: { type: 'f', value: v }, ip: '127.0.0.1', port: 9000 };",
