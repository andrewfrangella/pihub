 {
  "id": "reg_dump",
  "type": "function",
  "z": "hubtab",
  "name": "registry status",
  "func": "const devices = flow.get('devices') || {};\nconst now = Date.now();\nconst report = {};\nfor (const [name, d] of Object.entries(devices)) {\n  const age = now - d.lastSeen;\n  report[name] = { online: name === 'ml' ? (age < 3000 ? true : 'idle') : age < 3000, ip: d.ip, ageMs: age, params: d.params };\n}\nreturn { payload: report };",
  "outputs": 1,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 330,
