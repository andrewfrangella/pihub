   ]
  ]
 },
 {
  "id": "parse",
  "type": "function",
  "z": "hubtab",
  "name": "parse + registry",
  "func": "// msg.topic = OSC address, msg.payload = arg(s), msg.ip/msg.port = sender\nif (msg.topic === 'bundle') { return null; }\nconst parts = msg.topic.split('/').filter(Boolean);\nif (parts.length < 2) { node.warn('bad address: ' + msg.topic); return null; }\n\nconst device = parts[0];\nconst param  = parts.slice(1).join('/');\nconst value  = Array.isArray(msg.payload) && msg.payload.length === 1 ? msg.payload[0] : msg.payload;\n\nconst devices = flow.get('devices') || {};\nconst d = devices[device] || { params: {} };\nd.ip = msg.ip;\nd.lastSeen = Date.now();\nd.params[param] = value;\ndevices[device] = d;\nflow.set('devices', devices);\n\nconst out = { device, param, value, ip: msg.ip, topic: msg.topic };\n\n// output 2: copy numeric messages to the ML service (it ignores its own /ml/... echoes)\nlet toML = null;\nif (typeof value === 'number' && device !== 'ml') {\n  toML = { topic: msg.topic, payload: { type: 'f', value: value }, ip: '127.0.0.1', port: 9100 };\n}\nreturn [out, toML];",
  "outputs": 2,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 470,
  "y": 120,
  "wires": [
   [
    "dbg_in",
    "route"
   ],
   [
    "osc_ml"
   ]
  ]
 },
 {
