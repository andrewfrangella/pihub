  "type": "function",
  "z": "hubtab",
  "name": "fill ip from registry",
  "func": "const dev = msg.topic.split('/').filter(Boolean)[0];\nconst d = (flow.get('devices') || {})[dev];\nif (!d || !d.ip || (Date.now() - d.lastSeen) > 3000) { node.warn('device not online: ' + dev); return null; }\nmsg.ip = d.ip; msg.port = 9001;\nreturn msg;",
