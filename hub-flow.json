 {
  "id": "c_h2",
  "type": "comment",
  "z": "hubtab",
  "name": "2. routing table: source -> target device/param",
  "info": "",
  "x": 820,
  "y": 40,
  "wires": []
 },
 {
  "id": "route",
  "type": "function",
  "z": "hubtab",
  "name": "routing table",
  "func": "// source 'device/param' -> list of targets. Edit freely, then Deploy.\nconst routes = {\n  // direct wire, no ML:\n  // 'tv/m': [ { device: 'cassette', param: 'm', scale: 1.0 } ],\n\n  // ML prediction (virtual device 'ml') -> real device:\n  'ml/cassette/m': [ { device: 'cassette', param: 'm', scale: 1.0 } ],\n};\n\nconst key = msg.device + '/' + msg.param;\nconst targets = routes[key];\nif (!targets) { return null; }\nif (typeof msg.value !== 'number' || !isFinite(msg.value)) { node.warn('non-numeric value on ' + key); return null; }\n\nconst ONLINE_MS = 3000;   // a device is online if it has been heard from this recently\nconst devices = flow.get('devices') || {};\nconst out = [];\nfor (const t of targets) {\n  const dest = devices[t.device];\n  if (!dest || !dest.ip || (Date.now() - dest.lastSeen) > ONLINE_MS) {\n    node.status({ fill: 'red', shape: 'ring', text: t.device + ' offline' });\n    continue;\n  }\n  node.status({});\n  let v = msg.value * (t.scale || 1);\n  v = Math.max(0, Math.min(1, v));\n  out.push({ topic: '/' + t.device + '/set/' + t.param, payload: { type: 'f', value: v }, ip: dest.ip, port: 9001 });\n}\nreturn [out];",
  "outputs": 1,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 690,
  "y": 140,
  "wires": [
   [
    "osc_enc"
   ]
  ]
 },
 {
