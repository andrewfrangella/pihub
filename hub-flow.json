[
 {
  "id": "hubtab",
  "type": "tab",
  "label": "Hub Core",
  "disabled": false,
  "info": "OSC hub.\n\nContract:\n  Devices SEND state to hub   : UDP 9000, address /<device>/<param>, one float 0..1, ~20 Hz\n  Hub SENDS commands to device: UDP 9001 at the device's IP, address /<device>/set/<param>\n  ML service                  : receives a copy of every message on 127.0.0.1:9100,\n                                answers as virtual device \"ml\" (/ml/<device>/<param>) on 9000\n\nEvery incoming message updates flow.devices (last-seen, IP, latest value per param)."
 },
 {
  "id": "c_h1",
  "type": "comment",
  "z": "hubtab",
  "name": "1. receive + registry",
  "info": "",
  "x": 150,
  "y": 40,
  "wires": []
 },
 {
  "id": "udp_in",
  "type": "udp in",
  "z": "hubtab",
  "name": "OSC in :9000",
  "iface": "",
  "port": "9000",
  "ipv": "udp4",
  "multicast": "false",
  "group": "",
  "datatype": "buffer",
  "x": 120,
  "y": 120,
  "wires": [
   [
    "osc_dec"
   ]
  ]
 },
 {
