# Installed by install-hub.sh, which rewrites the user and paths below for this machine.
# Manual install: edit User= and the two paths, then: sudo cp ml/pihub-ml.service /etc/systemd/system/ && sudo systemctl enable --now pihub-ml
[Unit]
Description=pihub ML service (FluCoMa-compatible MLP)
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/pi-hub/ml
ExecStart=/home/pi/pi-hub/.venv/bin/python /home/pi/pi-hub/ml/ml-service.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
